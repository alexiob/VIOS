# Live development in the Turbo Vision style: the anim-browser steps after 1 UI-STYLE.
include setup
con 1 UI-STYLE
prompt
frame 500
ctrlshift b
frame 700
key DOWN
frame 400
key DOWN
frame 900
key TAB
key TAB
key TAB
key END c
frame 600
ktype : QUAD SQUARE SQUARE ;\n
frame 600
ctrl s
frame 1600
ctrlshift w
key END c
frame 500
ktype \n3 QUAD
frame 300
ctrl p
frame 2500
